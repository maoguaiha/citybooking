.page { padding-bottom: 140rpx; }
.status { font-size: 36rpx; font-weight: 700; }
.amount { font-size: 48rpx; color: #fa5151; font-weight: 700; margin: 12rpx 0; }
.sub { font-size: 28rpx; }

.row { display: flex; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid #f5f5f5; font-size: 28rpx; }
.row:last-child { border-bottom: none; }
.k { width: 160rpx; }
.v { flex: 1; text-align: right; color: #1f2329; }

.bar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; gap: 16rpx; padding: 16rpx 24rpx; background: #fff; border-top: 1rpx solid #f0f0f0; }
.act { flex: 1; margin: 0; }

.mask { position: fixed; inset: 0; background: rgba(0,0,0,0.45); display: flex; align-items: flex-end; }
.sheet { width: 100%; background: #fff; border-radius: 24rpx 24rpx 0 0; padding: 40rpx; }
.sheet-title { font-size: 32rpx; font-weight: 700; text-align: center; margin-bottom: 30rpx; }
.stars { text-align: center; margin-bottom: 30rpx; }
.star { font-size: 56rpx; color: #d9d9d9; margin: 0 10rpx; }
.star.on { color: #ffb400; }
.ta { width: 100%; height: 160rpx; background: #f5f6f8; border-radius: 16rpx; padding: 20rpx; box-sizing: border-box; font-size: 28rpx; }
.submit { margin-top: 30rpx; }
.cancel { margin-top: 16rpx; }
.empty { text-align: center; padding: 120rpx 0; }
