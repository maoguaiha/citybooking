page {
  background: #f5f6f8;
  font-family: -apple-system, "PingFang SC", Helvetica, sans-serif;
  color: #1f2329;
}
.btn-primary {
  background: #07c160;
  color: #fff;
  border-radius: 24rpx;
}
.btn-ghost {
  background: #fff;
  color: #07c160;
  border: 1rpx solid #07c160;
  border-radius: 24rpx;
}
.btn[disabled] {
  opacity: .5;
}
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.muted { color: #9aa0a6; }
.price { color: #fa5151; font-weight: 600; }
.flex { display: flex; align-items: center; }
.between { justify-content: space-between; }
