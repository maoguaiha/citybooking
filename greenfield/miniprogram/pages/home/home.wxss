.page { min-height: 100vh; }

/* 消费者端 */
.topbar { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 24rpx; background: #07c160; }
.search { flex: 1; display: flex; align-items: center; background: #fff; border-radius: 30rpx; padding: 0 20rpx; height: 64rpx; }
.ico { font-size: 28rpx; margin-right: 10rpx; }
.sinput { flex: 1; font-size: 28rpx; }
.loc { color: #fff; font-size: 26rpx; }
.cats { white-space: nowrap; padding: 16rpx 12rpx; background: #fff; border-bottom: 1rpx solid #f0f0f0; }
.cat { display: inline-block; padding: 10rpx 28rpx; margin: 0 8rpx; border-radius: 30rpx; background: #f2f3f5; color: #4e5969; font-size: 26rpx; }
.cat.on { background: #07c160; color: #fff; }
.empty { text-align: center; padding: 120rpx 0; }
.list { padding-bottom: 30rpx; }
.svc { display: flex; }
.svc-main { flex: 1; }
.svc-title { font-size: 32rpx; font-weight: 600; }
.svc-mer { font-size: 26rpx; margin: 12rpx 0; }
.svc-foot { display: flex; align-items: baseline; justify-content: space-between; }
.svc-foot .price { font-size: 34rpx; }

/* 商家/技师端 */
.mtabs { display: flex; background: #fff; border-bottom: 1rpx solid #f0f0f0; }
.mtab { flex: 1; text-align: center; padding: 24rpx 0; font-size: 28rpx; color: #4e5969; }
.mtab.on { color: #07c160; font-weight: 600; border-bottom: 4rpx solid #07c160; }
.order { display: block; }
.o-head { margin-bottom: 12rpx; }
.o-title { font-size: 32rpx; font-weight: 600; }
.o-status { font-size: 26rpx; color: #07c160; }
.o-row { font-size: 26rpx; margin-top: 6rpx; }
.o-foot { margin-top: 16rpx; }
.o-foot .price { font-size: 34rpx; }
.grab { margin: 0; padding: 0 28rpx; height: 56rpx; line-height: 56rpx; font-size: 26rpx; }
